          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金鑰儲存在 iCloud 鑰匙圈中，登入你 Apple 帳號的所有裝置都能使用。在 App 中刪除金鑰，也會在你的其他裝置上刪除。"
          }
