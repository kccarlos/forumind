        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 %@ API 金鑰。請在「設定 › AI 模型」中加入。"
          }
        }
      }
    },
    "%@ doesn’t look like a Discourse forum." : {
