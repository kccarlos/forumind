      }
    },
    "Forumind works on forums built with Discourse. Open one to summarize topics, chat about them, or ask the whole forum a question." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forumind 适用于基于 Discourse 的论坛。打开一个论坛，即可总结话题、围绕话题聊天，或向整个论坛提问。"
