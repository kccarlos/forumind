{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ API key is required." : {
      "comment" : "Error; the placeholder is the AI provider's name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 %@ API 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 %@ API 金鑰。"
          }
        }
      }
    },
    "%@ API key is required. Add it in Settings › AI models." : {
      "comment" : "Error; the placeholder is the AI provider's name. Settings › AI models names the app's own Settings pages.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 %@ API 密钥。请在“设置 › AI 模型”中添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 %@ API 金鑰。請在「設定 › AI 模型」中加入。"
          }
        }
      }
    },
    "%@ doesn’t look like a Discourse forum." : {
      "comment" : "Add forum error; the placeholder is a web address such as forum.example.com",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 看起来不是 Discourse 论坛。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 看起來不是 Discourse 論壇。"
          }
        }
      }
    },
    "%@ home" : {
      "comment" : "Button label: the forum's home page (forum name)",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 首页"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 首頁"
          }
        }
      }
    },
    "%@ isn’t connected. Add an API key in Settings › AI models." : {
      "comment" : "Error; the placeholder is the AI provider's name. Settings › AI models names the app's own Settings page.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 尚未连接。请在“设置 › AI 模型”中添加 API 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 尚未連線。請在「設定 › AI 模型」中加入 API 金鑰。"
          }
        }
      }
    },
    "%@ isn’t ready. Pick a model or add its key in Settings › AI models." : {
      "comment" : "Assistant card when one model role isn't ready. The placeholder is a provider and model, e.g. DeepSeek · deepseek-chat.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 尚未就绪。请在“设置 › AI 模型”中选择模型或添加它的密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 尚未就緒。請在「設定 › AI 模型」中選擇模型或加入它的金鑰。"
          }
        }
      }
    },
    "%@ settings" : {
      "comment" : "Link to a provider's key and address. The placeholder is the provider's name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 设置"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 設定"
          }
        }
      }
    },
    "%@ topic %@" : {
      "comment" : "Fallback title of a forum topic: forum name, then the topic's number",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ topic %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 话题 %2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 話題 %2$@"
          }
        }
      }
    },
    "%@ uses its own model. Choose one to continue; you can change it in Settings › AI models." : {
      "comment" : "Setup sheet for one model role. The placeholder is the role's name: Summaries & chat, or Ask the forum.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”使用单独的模型。请选择一个模型以继续；之后可在“设置 › AI 模型”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」使用獨立的模型。請選擇一個模型以繼續；之後可在「設定 › AI 模型」中更改。"
          }
        }
      }
    },
