    "Automatic" : {
      "comment" : "Browser address bar position: bottom on iPhone and in narrow windows, top in the iPad split layout\nWhen Forumind opens: Home on the first launch of the day when Today has something, else the last forum",
      "localizations" : {
        "zh-Hans" : {
