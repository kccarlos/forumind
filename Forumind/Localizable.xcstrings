    "Long topics take longer to read: a 2,000-post topic takes about 20 seconds." : {
      "comment" : "Forum requests footer for the Gentle pace (20 pages of 100 posts at 1 per second)",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长话题需要更久才能读完：一个 2,000 帖的话题约需 20 秒。"
          }
