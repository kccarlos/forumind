    "CFBundleName" : {
      "comment" : "Bundle name. The brand name; not translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forumind"
          }
        }
